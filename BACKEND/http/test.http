### =========================================================
### Workforce360 - Sprint 1 API Test Collection
### Base URL
### =========================================================

@host = http://localhost:4004/odata/v4/workforce

### =========================================================
### SERVICE ROOT
### =========================================================

GET {{host}}

### =========================================================
### METADATA
### =========================================================

GET {{host}}/$metadata

### =========================================================
### DEPARTMENTS
### =========================================================

### Get All Departments
GET {{host}}/Departments

###

### Get Department By ID
GET {{host}}/Departments(11111111-1111-1111-1111-111111111111)

###

### Create Department
POST {{host}}/Departments
Content-Type: application/json

{
    "name": "Engineering",
    "description": "Engineering Team",
    "location": "Bangalore"
}

###

### Create HR Department
POST {{host}}/Departments
Content-Type: application/json

{
    "name": "HR",
    "description": "Human Resources Department",
    "location": "Hyderabad"
}

###

### Update Department
PATCH {{host}}/Departments(11111111-1111-1111-1111-111111111111)
Content-Type: application/json

{
    "location": "Chennai"
}

###

### Delete Department
DELETE {{host}}/Departments(11111111-1111-1111-1111-111111111111)

### =========================================================
### EMPLOYEES
### =========================================================

### Get All Employees
GET {{host}}/Employees

###

### Get Employee By UUID
GET {{host}}/Employees(22222222-2222-2222-2222-222222222222)

###

### Create Employee
POST {{host}}/Employees
Content-Type: application/json

{
    "employeeId": "EMP001",
    "firstName": "Sareen",
    "lastName": "Garnaik",
    "email": "sareen@workforce360.com",
    "phone": "9876543210",
    "designation": "Software Engineer",
    "salary": 800000,
    "joiningDate": "2026-01-01",
    "status": "ACTIVE",
    "department_ID": "11111111-1111-1111-1111-111111111111"
}

###

### Create Second Employee
POST {{host}}/Employees
Content-Type: application/json

{
    "employeeId": "EMP002",
    "firstName": "John",
    "lastName": "Doe",
    "email": "john@workforce360.com",
    "phone": "9999999999",
    "designation": "HR Specialist",
    "salary": 700000,
    "joiningDate": "2025-05-10",
    "status": "ACTIVE",
    "department_ID": "11111111-1111-1111-1111-111111111111"
}

###

### Update Employee Designation
PATCH {{host}}/Employees(22222222-2222-2222-2222-222222222222)
Content-Type: application/json

{
    "designation": "Senior Software Engineer"
}

###

### Update Employee Salary
PATCH {{host}}/Employees(22222222-2222-2222-2222-222222222222)
Content-Type: application/json

{
    "salary": 1200000
}

###

### Update Employee Status
PATCH {{host}}/Employees(22222222-aaaa-bbbb-cccc-222222222222)
Content-Type: application/json

{
    "status": "PROBATION"
}

###

### Delete Employee
DELETE {{host}}/Employees(22222222
