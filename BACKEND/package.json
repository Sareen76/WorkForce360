{
  "name": "BACKEND",
  "version": "1.0.0",
  "dependencies": {
    "@sap/cds": "^10"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3",
    "cds-plugin-ui5": "^0.17.0"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-frontend": "cds watch --open com.capgemini.frontend/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "cds": {
    "model": [
      "db",
      "srv"
    ],
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": "workforce360V2.db"
        }
      },
      "auth": {
        "kind": "mocked",
        "users": {
          "hradmin": {
            "roles": [
              "HR_ADMIN"
            ]
          },
          "manager": {
            "roles": [
              "MANAGER"
            ]
          },
          "employee": {
            "roles": [
              "EMPLOYEE"
            ]
          }
        }
      }
    }
  },
  "private": true,
  "workspaces": [
    "app/*"
  ]
}
